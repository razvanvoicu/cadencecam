# See test.env: deliberately no GOOGLE_SERVICES, so login stays within openid/email/profile and the consent
# screen avoids Google's sensitive-scope verification review.
# GOOGLE_SERVICES=
# Zero for the same reason as test.env: every Cloud Run deployment is still a test deployment, because a phone is
# the only way to exercise the camera. Restore a real expiry when the deployments become genuinely production.
STATIC_ASSET_CACHE_MAX_AGE_SECONDS=0
