# No additional Google API entitlements: login requests only openid/email/profile. Requesting anything beyond
# those makes the OAuth consent screen subject to Google's sensitive-scope verification review, which this app
# has no reason to enter. Set a comma-separated list of scope URLs here only if a route must call a Google API
# on the signed-in user's behalf.
# GOOGLE_SERVICES=
STATIC_ASSET_CACHE_MAX_AGE_SECONDS=300
# Points the Firestore client at the local emulator (see firebase.json) instead of real GCP; the client library
# detects this variable itself and skips Application Default Credentials entirely when it's set.
FIRESTORE_EMULATOR_HOST=localhost:8880
