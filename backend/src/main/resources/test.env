GOOGLE_SERVICES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive.file
STATIC_ASSET_CACHE_MAX_AGE_SECONDS=300
# Points the Firestore client at the local emulator (see firebase.json) instead of real GCP; the client library
# detects this variable itself and skips Application Default Credentials entirely when it's set.
FIRESTORE_EMULATOR_HOST=localhost:8880
